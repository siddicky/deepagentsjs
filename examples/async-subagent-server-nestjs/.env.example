# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Tavily API key for real web search (subagent service only).
# If not set, stub search results are used instead.
TAVILY_API_KEY=

# ── Database (shared by both services) ───────────────────────────────────────
# Both services connect to the same Postgres instance.
# Subagent uses: threads, runs
# Supervisor uses: supervisor_threads
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentdb

# ── Subagent service ──────────────────────────────────────────────────────────
# Port for the subagent Agent Protocol server (default: 2024)
PORT_SUBAGENT=2024

# ── Supervisor service ────────────────────────────────────────────────────────
# URL of the subagent service. Supervisor uses this to delegate research tasks.
RESEARCHER_URL=http://localhost:2024

# Port for the supervisor NestJS service (default: 3000)
PORT_SUPERVISOR=3000
