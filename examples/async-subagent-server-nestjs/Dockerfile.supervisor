# Build from the repo root:
#   docker build -f examples/async-subagent-server-nestjs/Dockerfile.supervisor -t supervisor .
#
# Or via docker compose (context is set to repo root in docker-compose.yml).

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY libs/deepagents/package.json ./libs/deepagents/
COPY examples/async-subagent-server-nestjs/package.json ./examples/async-subagent-server-nestjs/
RUN pnpm install --frozen-lockfile --shamefully-hoist

FROM base AS runner
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY libs/deepagents/dist ./libs/deepagents/dist
COPY libs/deepagents/package.json ./libs/deepagents/package.json
COPY examples/async-subagent-server-nestjs/ ./examples/async-subagent-server-nestjs/

WORKDIR /app/examples/async-subagent-server-nestjs
EXPOSE 3000
CMD ["/app/node_modules/.bin/tsx", "apps/supervisor/src/main.ts"]
