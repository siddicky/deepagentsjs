{
  "$schema": "https://json.schemastore.org/nest-cli",
  "monorepo": true,
  "root": "apps/subagent",
  "sourceRoot": "apps/subagent/src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.json",
    "deleteOutDir": true
  },
  "projects": {
    "subagent": {
      "type": "application",
      "root": "apps/subagent",
      "entryFile": "main",
      "sourceRoot": "apps/subagent/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "supervisor": {
      "type": "application",
      "root": "apps/supervisor",
      "entryFile": "main",
      "sourceRoot": "apps/supervisor/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    }
  }
}
