{
  "name": "async-subagent-server-nestjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:subagent": "nest build subagent",
    "build:supervisor": "nest build supervisor",
    "build": "pnpm build:subagent && pnpm build:supervisor",
    "start:subagent": "node dist/apps/subagent/main.js",
    "start:supervisor": "node dist/apps/supervisor/main.js",
    "dev:subagent": "ts-node --transpile-only --project tsconfig.json apps/subagent/src/main.ts",
    "dev:supervisor": "ts-node --transpile-only --project tsconfig.json apps/supervisor/src/main.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.2.9",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "deepagents": "workspace:*",
    "dotenv": "^17.2.4",
    "langchain": "^1.3.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@langchain/tavily": "^1.2.0"
  }
}
