{
  "name": "async-subagent-server-nestjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:subagent": "nest build subagent",
    "build:supervisor": "nest build supervisor",
    "build": "pnpm build:subagent && pnpm build:supervisor",
    "start:subagent": "node dist/apps/subagent/main.js",
    "start:supervisor": "node dist/apps/supervisor/main.js",
    "dev:subagent": "tsx apps/subagent/src/main.ts",
    "dev:supervisor": "tsx apps/supervisor/src/main.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.21",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.3.0",
    "@nestjs/common": "^10.4.19",
    "@nestjs/core": "^10.4.19",
    "@nestjs/platform-express": "^10.4.19",
    "deepagents": "workspace:*",
    "dotenv": "^16.5.0",
    "langchain": "^1.4.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.10",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.15",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
